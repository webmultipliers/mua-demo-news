{
    "version": 1,
    "app": {
        "id": 65,
        "slug": "mustuse-news",
        "name": "MustUse News",
        "app_type": "mobile_ios",
        "app_types": [
            "mobile_ios",
            "mobile_android"
        ]
    },
    "assets": [],
    "branding": {
        "name": "",
        "logo_url": "",
        "primary_color": "#1e1e1e",
        "accent_color": "#2271b1",
        "privacy_policy_url": "",
        "support_email": "",
        "icon_url": "",
        "splash_url": "",
        "background_color": "#ffffff"
    },
    "routing": [],
    "navigation": [
        {
            "screen_id": "home-2",
            "label": "Home",
            "icon": "",
            "order": 0
        }
    ],
    "screen_tree": [
        {
            "screen_id": "home-2",
            "title": "Home",
            "icon": "",
            "children": []
        }
    ],
    "screens": [
        {
            "id": "home-2",
            "type": "screen",
            "title": "Home",
            "block_tree": [
                {
                    "type": "core\/heading",
                    "attributes": {
                        "level": 1
                    }
                },
                {
                    "type": "core\/paragraph",
                    "attributes": []
                }
            ]
        }
    ],
    "deeplink": null,
    "endpoints": {
        "content": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/content",
        "terms": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/terms",
        "capabilities": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/capabilities",
        "resolve_deeplink": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/resolve-deeplink",
        "auth_complete": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/auth\/complete",
        "auth_status": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/auth\/status",
        "auth_logout": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/auth\/logout",
        "subscriber_state": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/subscriber\/state",
        "bookmarks": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/bookmarks",
        "history": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/history",
        "push_enroll": "https:\/\/www.mustuse.com\/wp-json\/mustuse-apps-pub\/v1\/apps\/mustuse-news\/push\/enroll"
    },
    "requiredCapabilities": [],
    "renderers": {
        "mustuse-apps-pub\/article-card": {
            "version": 2,
            "description": "Single featured article. `postId` attribute drives an `id=` lookup on \/content; the response puts the article in items[0].",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "id": "{{ attributes.postId }}"
                },
                "bind": "items",
                "ttl": 600,
                "swr": true
            }
        },
        "mustuse-apps-pub\/article-grid": {
            "version": 2,
            "description": "Responsive article grid. Same fetch contract as article-list; the mobile Blade template lays it out as a grid instead of a stack.",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "post_type": "{{ attributes.postType }}",
                    "per_page": "{{ attributes.count }}",
                    "category": "{{ attributes.category }}"
                },
                "bind": "items",
                "ttl": 300,
                "swr": true
            }
        },
        "mustuse-apps-pub\/article-list": {
            "version": 2,
            "description": "List of articles fetched live from the pub's \/content endpoint. The shell's DynamicBlock Livewire component hydrates `items` at render time; pull-to-refresh invalidates the cache and re-fetches.",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "post_type": "{{ attributes.postType }}",
                    "per_page": "{{ attributes.count }}",
                    "category": "{{ attributes.category }}"
                },
                "bind": "items",
                "ttl": 300,
                "swr": true
            }
        },
        "mustuse-apps-pub\/auth-gate": {
            "type": "stack",
            "direction": "vertical",
            "spacing": 0,
            "children": [
                {
                    "type": "container",
                    "padding": {
                        "top": 32,
                        "bottom": 32,
                        "left": 24,
                        "right": 24
                    },
                    "children": [
                        {
                            "type": "stack",
                            "direction": "vertical",
                            "spacing": 16,
                            "align": "center",
                            "children": [
                                {
                                    "type": "icon",
                                    "name": "lock",
                                    "size": 32,
                                    "color": "#646970"
                                },
                                {
                                    "visible_when": "{{ attributes.gateHeading }}",
                                    "type": "text",
                                    "content": "{{ attributes.gateHeading }}",
                                    "style": "heading_3"
                                },
                                {
                                    "visible_when": "{{ attributes.gateDescription }}",
                                    "type": "text",
                                    "content": "{{ attributes.gateDescription }}",
                                    "style": "body"
                                },
                                {
                                    "type": "button",
                                    "label": "{{ attributes.ctaLabel }}",
                                    "style": "primary",
                                    "action": {
                                        "type": "capability",
                                        "capability": "biometrics",
                                        "callback": {
                                            "type": "state",
                                            "slot": "_auth_gate_unlocked"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "visible_when": "{{ state._auth_gate_unlocked }}",
                    "type": "inner_blocks"
                }
            ]
        },
        "mustuse-apps-pub\/author-card": {
            "version": 2,
            "description": "Renders the current context author. On \/author\/{slug} screens reads context.author; on article detail screens falls back to context.post.author.",
            "consumes_context": "author"
        },
        "mustuse-apps-pub\/bookmark-toggle": {
            "version": 2,
            "description": "Bookmark button for context.post. Persists via POST\/DELETE \/apps\/{slug}\/bookmarks with X-MUA-Device-Id header. Local SecureStorage cache keeps state across launches.",
            "consumes_context": "post"
        },
        "mustuse-apps-pub\/breaking-banner": {
            "type": "banner",
            "style": "alert",
            "label": "{{ attributes.label }}",
            "headline": "{{ attributes.headline }}",
            "action": {
                "type": "navigate",
                "target": {
                    "type": "path",
                    "value": "{{ attributes.linkUrl }}"
                }
            }
        },
        "mustuse-apps-pub\/category-pills": {
            "version": 2,
            "description": "Horizontal list of taxonomy terms (categories, tags, custom taxonomies). Fetched live from the \/terms endpoint. TTL is long because term metadata moves rarely; pull-to-refresh invalidates immediately.",
            "dataSource": {
                "kind": "terms",
                "endpoint": "terms",
                "method": "GET",
                "params": {
                    "taxonomy": "{{ attributes.taxonomy }}",
                    "per_page": "{{ attributes.count }}",
                    "include": "{{ attributes.categoryIds }}"
                },
                "bind": "items",
                "ttl": 1800,
                "swr": true
            }
        },
        "mustuse-apps-pub\/divider": {
            "type": "divider"
        },
        "mustuse-apps-pub\/hero": {
            "type": "container",
            "background": "{{ attributes.imageUrl.url }}",
            "background_mode": "cover",
            "padding": {
                "top": 64,
                "bottom": 48,
                "left": 24,
                "right": 24
            },
            "children": [
                {
                    "type": "stack",
                    "direction": "vertical",
                    "spacing": 12,
                    "align": "start",
                    "children": [
                        {
                            "visible_when": "{{ attributes.heading }}",
                            "type": "text",
                            "content": "{{ attributes.heading }}",
                            "style": "heading_1"
                        },
                        {
                            "visible_when": "{{ attributes.subheading }}",
                            "type": "text",
                            "content": "{{ attributes.subheading }}",
                            "style": "body_large"
                        },
                        {
                            "visible_when": "{{ attributes.ctaLabel }}",
                            "type": "button",
                            "label": "{{ attributes.ctaLabel }}",
                            "style": "primary",
                            "action": {
                                "type": "navigate",
                                "target": {
                                    "type": "{{ attributes.ctaTargetType }}",
                                    "value": "{{ attributes.ctaTargetValue }}"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        "mustuse-apps-pub\/image": {
            "type": "stack",
            "direction": "vertical",
            "spacing": 8,
            "children": [
                {
                    "type": "image",
                    "src": "{{ attributes.image.url }}",
                    "aspect_ratio": "16:9",
                    "fit": "cover",
                    "caption": "{{ attributes.caption }}",
                    "alt": "{{ attributes.alt }}"
                },
                {
                    "visible_when": "{{ attributes.caption }}",
                    "type": "text",
                    "content": "{{ attributes.caption }}",
                    "style": "caption"
                }
            ]
        },
        "mustuse-apps-pub\/list": {
            "type": "list",
            "style": "{{ attributes.style }}",
            "items_source": {
                "from": "attributes.items",
                "split": "newline"
            }
        },
        "mustuse-apps-pub\/native-action": {
            "type": "stack",
            "direction": "vertical",
            "spacing": 12,
            "children": [
                {
                    "type": "button",
                    "label": "{{ attributes.label }}",
                    "style": "primary",
                    "action": {
                        "type": "capability",
                        "capability": "{{ attributes.capability }}",
                        "callback": {
                            "type": "{{ attributes.callbackType }}",
                            "slot": "{{ attributes.callbackSlot }}",
                            "url": "{{ attributes.callbackUrl }}"
                        }
                    }
                },
                {
                    "visible_when": "{{ attributes.fallbackText }}",
                    "type": "text",
                    "content": "{{ attributes.fallbackText }}",
                    "style": "caption"
                }
            ]
        },
        "mustuse-apps-pub\/post-author-avatar": {
            "version": 2,
            "description": "Author avatar image for current context post.",
            "consumes_context": "post",
            "field": "author.avatar"
        },
        "mustuse-apps-pub\/post-author-name": {
            "version": 2,
            "description": "Author display name for current context post.",
            "consumes_context": "post",
            "field": "author.name"
        },
        "mustuse-apps-pub\/post-content": {
            "version": 2,
            "description": "Full post body (HTML). Reads context.post.content.",
            "consumes_context": "post",
            "field": "content"
        },
        "mustuse-apps-pub\/post-date": {
            "version": 2,
            "description": "Post publication date.",
            "consumes_context": "post",
            "field": "date"
        },
        "mustuse-apps-pub\/post-excerpt": {
            "version": 2,
            "description": "Plain-text post excerpt.",
            "consumes_context": "post",
            "field": "excerpt"
        },
        "mustuse-apps-pub\/post-featured-image": {
            "version": 2,
            "description": "Featured image from current context post.",
            "consumes_context": "post",
            "field": "featured_image"
        },
        "mustuse-apps-pub\/post-meta": {
            "version": 2,
            "description": "Single registered post_meta value by key.",
            "consumes_context": "post",
            "field": "meta"
        },
        "mustuse-apps-pub\/post-reading-time": {
            "version": 2,
            "description": "Reading time in minutes (225 wpm).",
            "consumes_context": "post",
            "field": "reading_time_min"
        },
        "mustuse-apps-pub\/post-template": {
            "version": 2,
            "description": "Iteration marker for Query Loop. The shell's QueryLoop Livewire component renders this block's innerBlocks once per item with context.post set to the current iteration. Direct rendering is a no-op.",
            "consumes_context": "post",
            "iterates": true
        },
        "mustuse-apps-pub\/post-terms": {
            "version": 2,
            "description": "Taxonomy terms attached to the current post, rendered as pills.",
            "consumes_context": "post",
            "field": "terms"
        },
        "mustuse-apps-pub\/post-title": {
            "version": 2,
            "description": "Current-context post title. Static \u2014 no fetch, just reads context.post.title.",
            "consumes_context": "post",
            "field": "title"
        },
        "mustuse-apps-pub\/push-enroll": {
            "version": 2,
            "description": "Push-notification opt-in prompt. Invokes NativePHP's PushNotifications::enroll on click; the #[OnNative(TokenGenerated)] listener syncs the returned token to \/push\/enroll keyed by X-MUA-Device-Id.",
            "required_capability": "push_notifications"
        },
        "mustuse-apps-pub\/query-loop": {
            "version": 2,
            "description": "Container that fetches N posts and sets `context.post` once per iteration of its post-template child. Non-post-template siblings (header \/ footer) render once without the per-item context.",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "post_type": "{{ attributes.postType }}",
                    "per_page": "{{ attributes.count }}",
                    "category": "{{ attributes.category }}",
                    "taxonomy": "{{ attributes.taxonomy }}",
                    "term": "{{ attributes.term }}",
                    "author": "{{ attributes.author }}",
                    "orderby": "{{ attributes.orderby }}",
                    "order": "{{ attributes.order }}"
                },
                "bind": "items",
                "ttl": 300,
                "swr": true
            },
            "provides_context": "post"
        },
        "mustuse-apps-pub\/quote": {
            "type": "quote",
            "text": "{{ attributes.text }}",
            "cite": "{{ attributes.cite }}"
        },
        "mustuse-apps-pub\/read-history-list": {
            "version": 2,
            "description": "Fetches per-device reading history. Keyed on X-MUA-Device-Id header; each item carries the same post context shape as \/content so post-title \/ featured-image render inline.",
            "dataSource": {
                "kind": "history",
                "endpoint": "history",
                "method": "GET",
                "params": [],
                "bind": "items",
                "ttl": 60,
                "swr": true
            }
        },
        "mustuse-apps-pub\/related-articles": {
            "version": 2,
            "description": "Related articles by category. Consumes the current `post` context to find the active category and excludes the current post from results. `related=1` is a ContentMapper hook that extensions can implement.",
            "consumes_context": "post",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "per_page": "{{ attributes.count }}",
                    "related": "1",
                    "exclude": "{{ context.post.id }}",
                    "category": "{{ context.post.primary_category_id }}"
                },
                "bind": "items",
                "ttl": 300,
                "swr": true
            }
        },
        "mustuse-apps-pub\/search-results": {
            "version": 2,
            "description": "Search results. Consumes the route context's `query` value (set by DeeplinkResolver for \/search?q=...) and streams it into the \/content search parameter.",
            "consumes_context": "search",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "post_type": "{{ attributes.postType }}",
                    "per_page": "{{ attributes.perPage }}",
                    "search": "{{ context.search.query }}"
                },
                "bind": "items",
                "ttl": 30,
                "swr": false
            }
        },
        "mustuse-apps-pub\/search": {
            "version": 2,
            "description": "Search input. Reads `context.search.query` (when on a search screen) so the current query sticks in the field after navigation; submitting navigates to \/search?q={value}.",
            "consumes_context": "search"
        },
        "mustuse-apps-pub\/section-heading": {
            "type": "stack",
            "direction": "vertical",
            "spacing": 8,
            "children": [
                {
                    "type": "text",
                    "content": "{{ attributes.text }}",
                    "style": "{{ attributes.level }}"
                },
                {
                    "type": "divider"
                }
            ]
        },
        "mustuse-apps-pub\/section": {
            "type": "section",
            "heading": "{{ attributes.heading }}",
            "see_all_label": "{{ attributes.seeAllLabel }}",
            "see_all_target": {
                "type": "path",
                "value": "{{ attributes.seeAllUrl }}"
            },
            "children": "{{ innerBlocks }}"
        },
        "mustuse-apps-pub\/spacer": {
            "type": "spacer",
            "size": "{{ attributes.size }}"
        },
        "mustuse-apps-pub\/text": {
            "type": "text",
            "content": "{{ attributes.content }}",
            "content_format": "html",
            "style": "body",
            "allowed_tags": [
                "p",
                "br",
                "strong",
                "em",
                "a",
                "ul",
                "ol",
                "li",
                "code"
            ]
        },
        "mustuse-apps-pub\/trending": {
            "version": 2,
            "description": "Numbered list of articles ordered by `comment_count` (default) or publisher-provided metric.",
            "dataSource": {
                "kind": "posts",
                "endpoint": "content",
                "method": "GET",
                "params": {
                    "post_type": "{{ attributes.postType }}",
                    "per_page": "{{ attributes.count }}",
                    "orderby": "{{ attributes.orderby }}",
                    "order": "DESC"
                },
                "bind": "items",
                "ttl": 300,
                "swr": true
            }
        },
        "mustuse-apps-pub\/video": {
            "type": "stack",
            "direction": "vertical",
            "spacing": 8,
            "children": [
                {
                    "type": "video_player",
                    "src": "{{ attributes.videoUrl }}",
                    "poster": "{{ attributes.posterImage.url }}"
                },
                {
                    "visible_when": "{{ attributes.caption }}",
                    "type": "text",
                    "content": "{{ attributes.caption }}",
                    "style": "caption"
                }
            ]
        }
    },
    "extensions": [],
    "cache_policy": {
        "manifest": {
            "ttl_seconds": 300,
            "strategy": "stale-while-revalidate"
        },
        "content": {
            "ttl_seconds": 900,
            "strategy": "stale-while-revalidate"
        },
        "assets": {
            "ttl_seconds": 86400,
            "strategy": "cache-first"
        }
    },
    "cache_invalidations": {
        "manifest": "0",
        "content": "0",
        "assets": "0"
    },
    "subscriber_state": null
}